{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "module": "es2020",
    "strict": true,
    "jsx": "react-native",
    "esModuleInterop": true,
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",

    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["**/*.ts","**/*.tsx",".expo/types/**/*.ts","expo-env.d.ts"],
  "exclude": ["node_modules"]
}
