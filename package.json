{
  "name": "thuisapp",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest --watchAll",
    "lint": "expo lint",
    "build:staging:android": "eas build --profile staging --platform android --non-interactive --no-wait",
    "build:staging:ios": "eas build --profile staging --platform ios --non-interactive --no-wait",
    "build:prod:android": "eas build --profile production --platform android --non-interactive --no-wait",
    "build:prod:ios": "eas build --profile production --platform ios --non-interactive --no-wait",
    "build:local:android": "eas build --profile development --platform android --local",
    "build:local:ios": "eas build --profile development --platform ios --local",
    "submit:android": "npm run build:prod:android -- --auto-submit",
    "submit:ios": "npm run build:prod:ios -- --auto-submit",
    "submit:staging:android": "npm run build:staging:android -- --auto-submit",
    "submit:staging:ios": "npm run build:staging:ios -- --auto-submit",
    "update:staging": "eas update --branch staging --clear-cache --environment preview --non-interactive",
    "update:prod": "eas update --branch production --clear-cache --environment production --non-interactive"
  },
  "dependencies": {
    "@expo-google-fonts/geist": "^0.4.0",
