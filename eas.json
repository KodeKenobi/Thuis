{
  "cli": {
    "version": ">= 12.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "image": "latest",
        "buildType": "apk"
      },
      "ios": {
        "image": "latest",
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "latest",
        "buildType": "apk"
      },
      "ios": {
        "image": "latest"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "android": {
        "image": "latest"
      }
    },
    "staging": {
      "extends": "preview",
      "channel": "staging",
      "autoIncrement": true,
      "environment": "preview",
      "android": {
        "buildType": "app-bundle"
      },
      "ios": {
        "distribution": "store"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "serviceAccountKeyPath": "./thuisapp.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "marco@databalk.nu",
        "ascAppId": "6720739031",
        "appleTeamId": "6HDZ9A2SR2"
      }
    },
    "staging": {
      "android": {
        "serviceAccountKeyPath": "./thuisapp.json",
        "track": "internal"
      },
      "ios": {
        "appleId": "marco@databalk.nu",
        "ascAppId": "6720739031",
        "appleTeamId": "6HDZ9A2SR2"
      }
    }
  }
}
